# Copiar este archivo como .env (no se commitea) y completar los valores.
# Sin SMTP_HOST el backend no envía mails: usa el notificador simulado.

# Usuario registrado de la sesión simulada y destinatario del mail en la demo.
EMAIL_DEMO=visitante@mail.com

# Servidor SMTP (Brevo). Puerto 587 usa STARTTLS; 465, TLS directo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
MAIL_REMITENTE=EcoHarmony Park <ecoharmonypark1@gmail.com>
